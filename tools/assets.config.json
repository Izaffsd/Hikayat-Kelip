{
  "comment": "Asset jobs for `npm run assets` (docs/ASSETS.md §1). Each Blender job writes raw GLBs to build-cache/raw; each output is optimised, content-hashed and published to public/assets/<group>/.",
  "blender": [
    {
      "id": "kampung_kit",
      "script": "tools/blender/kits/kampung.py",
      "outputs": [{ "file": "kampung_kit.glb", "group": "kits", "textureSize": 512 }]
    },
    {
      "id": "sawah_kit",
      "script": "tools/blender/kits/sawah.py",
      "outputs": [{ "file": "sawah_kit.glb", "group": "kits", "textureSize": 512 }]
    },
    {
      "id": "tokbelang",
      "script": "tools/blender/characters/tokbelang.py",
      "outputs": [{ "file": "tokbelang.glb", "group": "characters", "textureSize": 1024 }]
    },
    {
      "id": "spirits",
      "script": "tools/blender/characters/spirits.py",
      "outputs": [
        { "file": "kelip.glb", "group": "characters", "textureSize": 256, "keepAttributes": true },
        { "file": "wisp.glb", "group": "characters", "textureSize": 64, "keepAttributes": true }
      ]
    },
    {
      "id": "props_slice",
      "script": "tools/blender/props/slice_props.py",
      "outputs": [{ "file": "props_slice.glb", "group": "props", "textureSize": 512 }]
    },
    {
      "id": "anim_packs",
      "script": "tools/blender/anim/build_clips.py",
      "outputs": [
        { "file": "anim_core.glb", "group": "anim", "pipeline": "gltfpack", "gltfpackArgs": ["-ar", "14"] },
        {
          "file": "anim_villager.glb",
          "group": "anim",
          "pipeline": "gltfpack",
          "gltfpackArgs": ["-ar", "14"]
        },
        { "file": "anim_cursed.glb", "group": "anim", "pipeline": "gltfpack", "gltfpackArgs": ["-ar", "14"] }
      ]
    },
    {
      "id": "humans",
      "comment": "Needs build-cache/raw/anim_core.glb (the anim_packs job) as the rest-pose reference, so it runs after it.",
      "script": "tools/blender/characters/humans.py",
      "outputs": [
        { "file": "bayu.glb", "group": "characters", "textureSize": 1024 },
        { "file": "wan_young.glb", "group": "characters", "textureSize": 1024 },
        { "file": "adi.glb", "group": "characters", "textureSize": 1024 },
        { "file": "maksom.glb", "group": "characters", "textureSize": 1024 },
        { "file": "villager_man.glb", "group": "characters", "textureSize": 512 },
        { "file": "villager_elder.glb", "group": "characters", "textureSize": 512 },
        { "file": "villager_woman.glb", "group": "characters", "textureSize": 512 },
        { "file": "villager_woman_b.glb", "group": "characters", "textureSize": 512 },
        { "file": "villager_child.glb", "group": "characters", "textureSize": 512 }
      ]
    }
  ]
}
