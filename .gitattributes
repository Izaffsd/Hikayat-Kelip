# Normalize line endings: LF in the repo and the working tree (Prettier expects LF).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.glb binary
*.bin binary
*.ktx2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ogg binary
*.wav binary
*.flac binary
*.mp3 binary
*.wasm binary
*.blend binary
*.woff2 binary
*.ttf binary
*.otf binary
*.ico binary
