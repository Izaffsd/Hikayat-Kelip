# Hikayat Kelip environment variables. Copy to .env.local for local development.
# Never commit real values. Production values are set only in the Vercel dashboard (Settings > Environment Variables).

# --- Phase 6: competitive backend (Supabase) ---------------------------------------
# Public (shipped to the browser, read-only access through Row Level Security):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel Functions in /api; never prefix with VITE_):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Secret for signing run tokens and daily seeds (long random string):
RUN_TOKEN_SECRET=

# --- Telemetry ---------------------------------------------------------------------
# Set to "false" to disable the /api/event endpoint entirely.
TELEMETRY_ENABLED=true
